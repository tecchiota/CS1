import requests
import re
from collections import Counter


# -----------------------------
# INITIAL DATA
# -----------------------------

my_library = {
    "Moby Dick": {"url":"https://www.gutenberg.org/files/2701/2701-0.txt", "score":6}, 
    "The Count of Monte Cristo": {"url":"https://www.gutenberg.org/cache/epub/1184/pg1184.txt", "score":7},
    "The Odyssey": {"url":"https://www.gutenberg.org/files/28797/28797_readme.txt", "score":10}
}

# TODO 3: Read stop words from a file instead; this file "EN-Stopwords" contains thousands stop words(2 points)
try:
    with open("EN-Stopwords.txt", "r") as f:
        STOP_WORDS = {line.strip().lower() for line in f if line.strip()}
except FileNotFoundError:
    print("En-Stopwords.txt not found")

# -----------------------------
# FETCH BOOK
# -----------------------------
def fetch_book(url):
    """Download text from a URL."""
    # TODO 4: Handle exceptions (network errors, invalid URLs, etc.) (1 point)
    try:
        response = requests.get(url, timeout=10)
        response.raise_for_status()
        return response.text
    except requests.exceptions.RequestException:
        print(f"Failed to fetch book.")
        return None
# -----------------------------
# CLEAN TEXT
# -----------------------------
def clean_text(raw_text):
    """Lowercase text and remove punctuation."""
    text = raw_text.lower()
    text = re.sub(r'[^a-z\s]', '', text)
    return text.split()

# -----------------------------
# ANALYZE TEXT
# -----------------------------
def analyze_text(words):
    """Remove stop words and count frequencies."""
    filtered_words = [w for w in words if w not in STOP_WORDS and len(w) > 2]   #checking len(w)> 2 to remove tiny words((is, to, at))
    return Counter(filtered_words).most_common(10)



# -----------------------------
# VISUALIZATION (BAR CHART)
# -----------------------------

def plot_results(stats, title, score):
    """Create a bar chart of word frequencies."""
    print(f"\n---{title.upper()} (Review Score: {score}/10) ---")
    print("-" * 90)
    for word, count in stats:
        bar = "█" * (count // 50)
        print(f"{word:>15} | {bar} {count}")

